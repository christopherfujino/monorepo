CC = bear --append -- clang
AR = llvm-ar
PROJECT = c23
DEBUG_FLAGS = -g -O0
CFLAGS = $DEBUG_FLAGS \
				-std=c23 \
				-Wall -Werror -Wextra -Wpedantic \
				-I$PWD/include
LDFLAGS =
DEPFILES = `{/bin/sh -c 'find . -name "*.d"'}

all:V: enum.exe

<|cat $DEPFILES /dev/null

%.exe: bin/%.o lib/lib$PROJECT.a
	$CC $LDFLAGS \
		$prereq -o $target

bin/%.o: bin/%.c
  $CC $CFLAGS \
    -MT $target -MMD -MP -MF bin/$stem.d \
    -c bin/$stem.c -o $target

lib/lib$PROJECT.a: lib/mod1.o
	$AR rcs $target $prereq

lib/%.o: lib/%.c
  $CC $CFLAGS \
    -MT $target -MMD -MP -MF lib/$stem.d \
    -c lib/$stem.c -o $target

clean:V:
	rm -rf *.exe *.o *.d *.a compile_commands.json
	(cd bin && rm -f *.d *.o *.a *.exe)
	(cd lib && rm -f *.d *.o *.a)

